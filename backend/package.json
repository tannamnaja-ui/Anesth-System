{
  "name": "anesth-system-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for Anesth System (login, DB connection settings, patient data)",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "package": "pkg . --targets node20-win-x64 --output ../build/AnesthServer.exe"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "mysql2": "^3.11.0",
    "pg": "^8.12.0"
  },
  "pkg": {
    "assets": [
      "node_modules/mysql2/**/*",
      "node_modules/pg/**/*"
    ]
  }
}
